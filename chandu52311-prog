<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SSC Official Photo Resizer - 20KB to 50KB</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background-color: #0b1120; color: #f8fafc; padding: 16px; display: flex; flex-direction: column; align-items: center; min-height: 100vh; }
    .container { width: 100%; max-width: 420px; display: flex; flex-direction: column; align-items: center; }
    h1 { font-size: 1.5rem; font-weight: 800; color: #38bdf8; text-align: center; margin-bottom: 4px; letter-spacing: 0.5px; }
    p.sub { font-size: 0.8rem; color: #94a3b8; text-align: center; margin-bottom: 12px; }
    .paper-ad-slot { width: 100%; min-height: 60px; background: #1e293b; border: 1px dashed #64748b; border-radius: 8px; display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 10px 0; padding: 6px; }
    .ad-badge { font-size: 0.65rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
    .ad-demo-text { font-size: 0.75rem; color: #38bdf8; font-weight: 600; }
    .passport-box { width: 160px; height: 200px; border: 2px dashed #38bdf8; border-radius: 10px; background: #111827; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; margin: 12px 0; box-shadow: 0 4px 15px rgba(56, 189, 248, 0.15); }
    .passport-box:active { transform: scale(0.98); }
    .passport-box img { width: 100%; height: 100%; object-fit: cover; display: none; }
    .passport-box .icon { font-size: 2.2rem; color: #38bdf8; margin-bottom: 6px; }
    .passport-box .placeholder-text { font-size: 0.75rem; color: #cbd5e1; text-align: center; padding: 0 10px; }
    .btn { width: 100%; padding: 14px; border: none; border-radius: 10px; font-weight: 700; font-size: 1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 4px; }
    .btn-generate { background: #0284c7; color: white; box-shadow: 0 4px 14px rgba(2, 132, 199, 0.4); }
    .btn-generate:active { background: #0369a1; transform: scale(0.98); }
    .btn-download { background: #16a34a; color: white; box-shadow: 0 4px 14px rgba(22, 163, 74, 0.4); }
    .btn-download:active { background: #15803d; transform: scale(0.98); }
    .output-card { width: 100%; background: #1e293b; border-radius: 12px; border: 1px solid #334155; padding: 16px; margin-top: 15px; display: none; flex-direction: column; align-items: center; }
    .output-card .specs-pill { background: #0f172a; border: 1px solid #22c55e; color: #4ade80; padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; margin-bottom: 12px; }
    .output-preview { width: 140px; height: 175px; border-radius: 6px; border: 2px solid #22c55e; object-fit: cover; margin-bottom: 8px; }
    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.88); display: none; align-items: center; justify-content: center; padding: 20px; z-index: 100; }
    .modal-box { background: #1e293b; width: 100%; max-width: 340px; padding: 24px 20px; border-radius: 16px; text-align: center; border: 1px solid #475569; }
    .modal-box h3 { font-size: 1.15rem; color: #fff; margin-bottom: 8px; }
    .modal-box p { font-size: 0.85rem; color: #94a3b8; margin-bottom: 16px; line-height: 1.4; }
    .timer-circle { width: 55px; height: 55px; border-radius: 50%; background: #0284c7; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 800; margin: 0 auto 16px; }
  </style>
</head>
<body>
  <div class="container">
    <h1>SSC PHOTO RESIZER</h1>
    <p class="sub">Official 20 KB – 50 KB Guarantee (CGL / CHSL / MTS)</p>
    <div class="paper-ad-slot">
      <span class="ad-badge">Advertisement</span>
      <span class="ad-demo-text">🔥 Crack SSC CGL - Best Mock Tests 2026</span>
    </div>
    <input type="file" id="fileInput" accept="image/*" style="display: none;" onchange="handleFileSelect(event)">
    <div class="passport-box" onclick="document.getElementById('fileInput').click()">
      <div id="uploadPrompt" style="display: flex; flex-direction: column; align-items: center;">
        <span class="icon">📷</span>
        <span class="placeholder-text">Tap to select Passport Photo</span>
      </div>
      <img id="inputPreview" alt="Selected Photo">
    </div>
    <button class="btn btn-generate" onclick="generateSSCPhoto()">⚡ GENERATE SSC PHOTO</button>
    <div class="paper-ad-slot">
      <span class="ad-badge">Advertisement</span>
      <span class="ad-demo-text">⚡ Top Coaching Notes & Free PDF Downloads</span>
    </div>
    <div class="output-card" id="outputCard">
      <div class="specs-pill">SSC READY: 3.5cm x 4.5cm • 36.2 KB</div>
      <img id="outputImg" class="output-preview" alt="Generated Photo">
      <div class="paper-ad-slot">
        <span class="ad-badge">Advertisement</span>
        <span class="ad-demo-text">💼 Apply to 50,000+ Latest Govt Vacancies</span>
      </div>
      <button class="btn btn-download" onclick="startDownloadWithAd()">📥 Free Download (Watch Ad)</button>
      <div class="paper-ad-slot">
        <span class="ad-badge">Advertisement</span>
        <span class="ad-demo-text">📢 Join SSC Official Discussion & Updates Group</span>
      </div>
    </div>
  </div>
  <div class="modal-overlay" id="adModal">
    <div class="modal-box">
      <div class="timer-circle" id="countdown">5</div>
      <h3>Sponsor Video Playing...</h3>
      <p>Your SSC photo is compressed to official specs. Download will begin when timer ends.</p>
    </div>
  </div>
  <script>
    let rawImage = null;
    let base64Output = null;
    function handleFileSelect(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        const preview = document.getElementById('inputPreview');
        preview.src = e.target.result;
        preview.style.display = 'block';
        document.getElementById('uploadPrompt').style.display = 'none';
        rawImage = new Image();
        rawImage.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }
    async function generateSSCPhoto() {
      if (!rawImage) { alert("Please tap the passport frame to upload your photo first!"); return; }
      const canvas = document.createElement('canvas');
      canvas.width = 350; canvas.height = 450;
      const ctx = canvas.getContext('2d');
      const imgRatio = rawImage.width / rawImage.height;
      const targetRatio = 350 / 450;
      let sWidth, sHeight, sx, sy;
      if (imgRatio > targetRatio) {
        sHeight = rawImage.height; sWidth = rawImage.height * targetRatio;
        sx = (rawImage.width - sWidth) / 2; sy = 0;
      } else {
        sWidth = rawImage.width; sHeight = rawImage.width / targetRatio;
        sx = 0; sy = (rawImage.height - sHeight) / 2;
      }
      ctx.drawImage(rawImage, sx, sy, sWidth, sHeight, 0, 0, 350, 450);
      let minQ = 0.1, maxQ = 0.95, targetQuality = 0.6;
      for (let i = 0; i < 6; i++) {
        let midQ = (minQ + maxQ) / 2;
        let testData = canvas.toDataURL('image/jpeg', midQ);
        let sizeKb = (testData.length * 0.75) / 1024;
        targetQuality = midQ;
        if (sizeKb > 42) maxQ = midQ; else minQ = midQ;
      }
      base64Output = canvas.toDataURL('image/jpeg', targetQuality);
      const finalSizeKb = ((base64Output.length * 0.75) / 1024).toFixed(1);
      document.getElementById('outputImg').src = base64Output;
      document.querySelector('.specs-pill').innerText = `SSC APPROVED: 3.5cm x 4.5cm • ${finalSizeKb} KB`;
      document.getElementById('outputCard').style.display = 'flex';
      document.getElementById('outputCard').scrollIntoView({ behavior: 'smooth' });
    }
    function startDownloadWithAd() {
      if (!base64Output) return;
      const modal = document.getElementById('adModal');
      const counter = document.getElementById('countdown');
      modal.style.display = 'flex';
      let timeLeft = 5;
      counter.innerText = timeLeft;
      const timer = setInterval(() => {
        timeLeft--;
        counter.innerText = timeLeft;
        if (timeLeft <= 0) {
          clearInterval(timer);
          modal.style.display = 'none';
          const link = document.createElement('a');
          link.href = base64Output;
          link.download = `SSC_Passport_Photo_${Date.now()}.jpg`;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        }
      }, 1000);
    }
  </script>
</body>
</html>
